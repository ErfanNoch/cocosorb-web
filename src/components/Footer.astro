---
/**
 * Footer - COCOSORB
 * Navigasi footer, kontak resmi, tautan sosial, dan hak cipta.
 * Bebas emoji, bebas em dash, selaras dengan design system.
 */
import { BRAND, CONTACT, FOOTER_NAV } from '../config/site';
---

<footer class="footer" role="contentinfo">
  <div class="container footer__inner">

    <!-- Brand -->
    <div class="footer__brand">
      <a href="/" class="footer__logo" aria-label={`${BRAND.name} - Kembali ke atas`}>
        <span class="footer__brand-text">COCOSORB</span>
      </a>
      <p class="footer__tagline">
        Solusi alami pengendali bau berbasis<br />
        sirkular lokal. VOC-free. Kriya nusantara.
      </p>
      <!-- Social Media -->
      <div class="footer__socials">
        <a
          href={CONTACT.instagram}
          target="_blank"
          rel="noopener noreferrer"
          class="footer__social-link"
          aria-label="Instagram COCOSORB"
          id="footer-instagram"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
            <circle cx="12" cy="12" r="4"/>
            <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"/>
          </svg>
          Instagram
        </a>
        <a
          href={CONTACT.tiktok}
          target="_blank"
          rel="noopener noreferrer"
          class="footer__social-link"
          aria-label="TikTok COCOSORB"
          id="footer-tiktok"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/>
          </svg>
          TikTok
        </a>
      </div>
    </div>

    <!-- Navigation Links -->
    <nav class="footer__nav" aria-label="Navigasi Footer">
      {FOOTER_NAV.map(col => (
        <div class="footer__nav-col">
          <h4 class="footer__nav-title">{col.title}</h4>
          <ul class="footer__nav-list">
            {col.links.map(link => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </div>
      ))}

      <!-- Contact direct col -->
      <div class="footer__nav-col">
        <h4 class="footer__nav-title">Hubungi Kami</h4>
        <ul class="footer__nav-list footer__nav-list--contact">
          <li>
            <a
              href={CONTACT.whatsapp.url}
              target="_blank"
              rel="noopener noreferrer"
              id="footer-wa"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
                <path d="M12 0C5.373 0 0 5.373 0 12c0 2.083.535 4.04 1.472 5.745L0 24l6.405-1.438A11.93 11.93 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.89 0-3.658-.518-5.175-1.415l-.371-.22-3.802.854.855-3.717-.242-.383A9.937 9.937 0 0 1 2 12c0-5.514 4.486-10 10-10s10 4.486 10 10-4.486 10-10 10z"/>
              </svg>
              WhatsApp Business
            </a>
          </li>
          <li>
            <a href={`mailto:${CONTACT.email}`} id="footer-email">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                <rect x="2" y="4" width="20" height="16" rx="2"/>
                <path d="m2 4 10 9 10-9"/>
              </svg>
              {CONTACT.email}
            </a>
          </li>
          <li>
            <a href="#contact" id="footer-form-link">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
              </svg>
              Formulir Pesan
            </a>
          </li>
        </ul>
      </div>
    </nav>

  </div>

  <!-- Bottom Bar -->
  <div class="footer__bottom">
    <div class="container footer__bottom-inner">
      <p class="footer__copy">
        &copy; {BRAND.year} {BRAND.name}. Hak Cipta Dilindungi. Tim <strong>{BRAND.team}</strong>.
      </p>
      <div class="footer__badges">
        <span class="footer__badge">Upcycled Biomass</span>
        <span class="footer__badge">100% VOC-Free</span>
        <span class="footer__badge">UMKM Kriya Lokal</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-charcoal);
    color: var(--color-surface);
  }

  /* ── Main Footer Body ────────────────────────── */
  .footer__inner {
    display: grid;
    grid-template-columns: 1.3fr 2fr;
    gap: 4rem;
    padding-block: 4.5rem 3.5rem;
  }

  /* ── Brand Column ────────────────────────────── */
  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .footer__logo {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
  }

  .footer__brand-text {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: #FFFFFF;
    text-transform: uppercase;
    transition: color var(--duration-base) var(--ease-smooth);
  }

  .footer__logo:hover .footer__brand-text {
    color: var(--color-coconut-light);
  }

  .footer__tagline {
    font-size: var(--text-body-sm);
    color: var(--color-mist);
    line-height: 1.7;
    margin: 0;
    opacity: 0.8;
  }

  .footer__socials {
    display: flex;
    gap: 1.25rem;
    align-items: center;
    padding-top: 0.5rem;
  }

  .footer__social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-caption);
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--color-mist);
    text-decoration: none;
    opacity: 0.8;
    transition: opacity var(--duration-base) var(--ease-smooth), color var(--duration-base) var(--ease-smooth);
  }

  .footer__social-link:hover {
    opacity: 1;
    color: var(--color-coconut-light);
  }

  /* ── Navigation Columns ──────────────────────── */
  .footer__nav {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .footer__nav-col {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .footer__nav-title {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-coconut-light);
    margin: 0;
  }

  .footer__nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer__nav-list a {
    font-size: var(--text-body-sm);
    color: var(--color-mist);
    text-decoration: none;
    opacity: 0.75;
    transition: opacity var(--duration-base) var(--ease-smooth), color var(--duration-base) var(--ease-smooth);
  }

  .footer__nav-list a:hover {
    opacity: 1;
    color: #FFFFFF;
  }

  .footer__nav-list--contact a {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
  }

  /* ── Bottom Bar ──────────────────────────────── */
  .footer__bottom {
    border-top: 1px solid rgba(232, 228, 221, 0.1);
    padding-block: 1.5rem;
  }

  .footer__bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .footer__copy {
    font-size: var(--text-caption);
    color: var(--color-mist);
    margin: 0;
    opacity: 0.7;
  }

  .footer__copy strong {
    color: #FFFFFF;
  }

  .footer__badges {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .footer__badge {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--color-mist);
    background-color: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-pill);
  }

  /* ── Responsive ─────────────────────────────── */
  @media (max-width: 900px) {
    .footer__inner {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .footer__nav {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
    }
  }

  @media (max-width: 600px) {
    .footer__nav {
      grid-template-columns: 1fr;
    }

    .footer__bottom-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
  }
</style>
