---
/**
 * HowItWorksSection - COCOSORB
 * Comparison + lifespan guide. No emoji, clean typography.
 */
import { HOW_IT_WORKS } from '../../config/site';
---

<section id="how-it-works" class="section hiw">
  <div class="container">

    <!-- Header -->
    <div class="hiw__header reveal">
      <div class="eyebrow">{HOW_IT_WORKS.eyebrow}</div>
      <h2 class="text-h2 hiw__title">
        {HOW_IT_WORKS.title.map((line, i) =>
          i === HOW_IT_WORKS.titleAccent
            ? <em>{line}</em>
            : <>{line}<br /></>
        )}
      </h2>
      <p class="text-body-lg text-charcoal-soft hiw__intro">
        {HOW_IT_WORKS.intro}
      </p>
    </div>

    <!-- Comparison -->
    <div class="hiw__compare">

      <!-- Bad: Masking -->
      <div class="hiw__card hiw__card--bad reveal delay-100">
        <div class="hiw__card-label hiw__card-label--bad">
          <div class="hiw__card-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
              <circle cx="9" cy="9" r="8" stroke="currentColor" stroke-width="1.3"/>
              <path d="M5.5 5.5L12.5 12.5M12.5 5.5L5.5 12.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
          <div>
            <h3 class="hiw__card-method">{HOW_IT_WORKS.comparison.bad.method}</h3>
            <p class="hiw__card-sub">{HOW_IT_WORKS.comparison.bad.subtitle}</p>
          </div>
        </div>
        <p class="hiw__card-desc">{HOW_IT_WORKS.comparison.bad.description}</p>
        <ul class="hiw__list hiw__list--cons" aria-label="Kelemahan masking">
          {HOW_IT_WORKS.comparison.bad.points.map(p => (
            <li>{p}</li>
          ))}
        </ul>
      </div>

      <!-- VS -->
      <div class="hiw__vs" aria-hidden="true">
        <span>VS</span>
      </div>

      <!-- Good: Adsorpsi -->
      <div class="hiw__card hiw__card--good reveal delay-300">
        <div class="hiw__card-label hiw__card-label--good">
          <div class="hiw__card-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
              <circle cx="9" cy="9" r="8" stroke="currentColor" stroke-width="1.3"/>
              <path d="M5 9.5l3 3 5-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div>
            <h3 class="hiw__card-method">{HOW_IT_WORKS.comparison.good.method}</h3>
            <p class="hiw__card-sub">{HOW_IT_WORKS.comparison.good.subtitle}</p>
          </div>
        </div>
        <p class="hiw__card-desc">{HOW_IT_WORKS.comparison.good.description}</p>
        <ul class="hiw__list hiw__list--pros" aria-label="Keunggulan adsorpsi aktif">
          {HOW_IT_WORKS.comparison.good.points.map(p => (
            <li>{p}</li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Lifespan Guide -->
    <div class="hiw__lifespan reveal">
      <h3 class="hiw__lifespan-title">Panduan Masa Pakai &amp; Perawatan</h3>
      <div class="hiw__steps">
        {HOW_IT_WORKS.lifespanSteps.map(s => (
          <div class="hiw__step" id={s.id}>
            <div class="hiw__step-track" aria-hidden="true">
              <div class="hiw__step-num">{s.step}</div>
              {s.step < HOW_IT_WORKS.lifespanSteps.length && (
                <div class="hiw__step-line"></div>
              )}
            </div>
            <div class="hiw__step-body">
              <h4 class="hiw__step-title">{s.title}</h4>
              <p class="hiw__step-desc">{s.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<style>
  .hiw {
    background-color: var(--color-surface);
  }

  /* ── Header ──────────────────────────────────── */
  .hiw__header {
    max-width: 640px;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 3.5rem;
  }

  .hiw__title {
    margin: 0;
    color: var(--color-charcoal);
  }

  .hiw__title em {
    font-style: italic;
    color: var(--color-coconut);
  }

  .hiw__intro { margin: 0; }

  /* ── Compare ─────────────────────────────────── */
  .hiw__compare {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1.5rem;
    align-items: start;
    margin-bottom: 4rem;
  }

  .hiw__card {
    padding: 2rem;
    border-radius: var(--radius-xl);
    border: 1.5px solid;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .hiw__card--bad {
    background-color: color-mix(in srgb, #B23C3C 4%, var(--color-canvas));
    border-color: color-mix(in srgb, #B23C3C 15%, transparent);
  }

  .hiw__card--good {
    background-color: color-mix(in srgb, var(--color-sage) 6%, var(--color-canvas));
    border-color: color-mix(in srgb, var(--color-sage) 22%, transparent);
  }

  .hiw__card-label {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
  }

  .hiw__card-icon {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 0.125rem;
  }

  .hiw__card-label--bad .hiw__card-icon {
    background-color: rgba(178,60,60,0.1);
    color: #B23C3C;
  }

  .hiw__card-label--good .hiw__card-icon {
    background-color: color-mix(in srgb, var(--color-sage) 12%, transparent);
    color: var(--color-sage);
  }

  .hiw__card-method {
    font-family: var(--font-serif);
    font-size: var(--text-h4);
    color: var(--color-charcoal);
    margin: 0;
    line-height: 1.2;
  }

  .hiw__card-sub {
    font-size: var(--text-caption);
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--color-charcoal-soft);
    margin: 0.25rem 0 0;
  }

  .hiw__card-desc {
    font-size: var(--text-body-sm);
    color: var(--color-charcoal-soft);
    line-height: 1.75;
    margin: 0;
  }

  .hiw__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .hiw__list li {
    font-size: var(--text-body-sm);
    color: var(--color-charcoal-soft);
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    line-height: 1.6;
  }

  .hiw__list--cons li::before {
    content: '✕';
    color: #B23C3C;
    font-weight: 700;
    flex-shrink: 0;
    line-height: 1.6;
  }

  .hiw__list--pros li::before {
    content: '✓';
    color: var(--color-sage);
    font-weight: 700;
    flex-shrink: 0;
    line-height: 1.6;
  }

  /* VS Separator */
  .hiw__vs {
    align-self: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: var(--color-charcoal);
    color: var(--color-surface);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    flex-shrink: 0;
  }

  /* ── Lifespan ─────────────────────────────────── */
  .hiw__lifespan {
    background-color: var(--color-canvas);
    border-radius: var(--radius-xl);
    padding: 2.5rem;
    border: 1px solid var(--color-mist);
  }

  .hiw__lifespan-title {
    font-family: var(--font-serif);
    font-size: var(--text-h3);
    color: var(--color-charcoal);
    margin: 0 0 2.5rem;
  }

  .hiw__steps {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0 3rem;
  }

  .hiw__step {
    display: flex;
    gap: 1.25rem;
    padding-bottom: 2rem;
  }

  .hiw__step-track {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
    gap: 0;
  }

  .hiw__step-num {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background-color: var(--color-coconut);
    color: var(--color-surface);
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 2px 8px rgba(164,130,97,0.3);
  }

  .hiw__step-line {
    width: 1px;
    flex: 1;
    min-height: 2rem;
    background: linear-gradient(to bottom, var(--color-coconut-light), transparent);
    margin-top: 0.375rem;
  }

  .hiw__step-body {
    padding-bottom: 0.5rem;
    flex: 1;
  }

  .hiw__step-body h4 {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-charcoal);
    margin: 0 0 0.5rem;
    line-height: 1.3;
  }

  .hiw__step-body p {
    font-size: var(--text-body-sm);
    color: var(--color-charcoal-soft);
    line-height: 1.75;
    margin: 0;
  }

  /* ── Responsive ─────────────────────────────── */
  @media (max-width: 1024px) {
    .hiw__compare {
      grid-template-columns: 1fr;
    }
    .hiw__vs {
      justify-self: start;
    }
  }

  @media (max-width: 768px) {
    .hiw__steps {
      grid-template-columns: 1fr;
    }
  }
</style>
