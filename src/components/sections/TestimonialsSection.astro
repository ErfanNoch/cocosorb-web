---
/**
 * TestimonialsSection - COCOSORB
 * Avatar initials (no emoji), star ratings, lab banner.
 */
import { TESTIMONIALS, LAB_RESULT } from '../../config/site';
---

<section id="testimonials" class="section testi">
  <div class="container">

    <!-- Header -->
    <div class="testi__header reveal">
      <div class="eyebrow">Ulasan &amp; Validasi</div>
      <h2 class="text-h2 testi__title">
        Dipercaya Pengguna<br />
        <em>dari Rumah ke Rumah.</em>
      </h2>
    </div>

    <!-- Lab Result Banner -->
    <div class="testi__lab reveal delay-100">
      <div class="testi__lab-icon-wrap" aria-hidden="true">
        <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
          <path d="M10 4V14L4 22H24L18 14V4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M8 4H20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          <circle cx="12" cy="18" r="1.5" fill="currentColor" opacity="0.5"/>
          <circle cx="16" cy="20" r="1" fill="currentColor" opacity="0.3"/>
        </svg>
      </div>
      <div class="testi__lab-body">
        <h3 class="testi__lab-title">Divalidasi Uji Laboratorium Independen</h3>
        <p class="testi__lab-desc">{LAB_RESULT.description}</p>
      </div>
      <div class="testi__lab-stat" aria-label={`Hasil: ${LAB_RESULT.percentage} pengurangan bau`}>
        <span class="testi__lab-num">{LAB_RESULT.percentage}</span>
        <span class="testi__lab-label">{LAB_RESULT.label}</span>
      </div>
    </div>

    <!-- Cards Grid -->
    <div class="testi__grid">
      {TESTIMONIALS.map((t, index) => (
        <article
          class={`tcard reveal delay-${(index % 2 + 1) * 100}`}
          id={t.id}
          aria-label={`Ulasan dari ${t.name}`}
        >
          <!-- Rating -->
          <div class="tcard__stars" role="img" aria-label={`${t.rating} dari 5 bintang`}>
            {Array.from({ length: 5 }).map((_, i) => (
              <svg
                width="14"
                height="14"
                viewBox="0 0 14 14"
                fill={i < t.rating ? 'currentColor' : 'none'}
                stroke="currentColor"
                stroke-width="1"
                aria-hidden="true"
              >
                <polygon points="7,1.5 8.8,5.5 13,5.9 9.8,8.7 10.8,13 7,10.8 3.2,13 4.2,8.7 1,5.9 5.2,5.5"/>
              </svg>
            ))}
          </div>

          <!-- Quote -->
          <blockquote class="tcard__quote">
            <p>"{t.text}"</p>
          </blockquote>

          <!-- Tags -->
          <div class="tcard__tags">
            {t.tags.map(tag => (
              <span class="badge badge-natural">{tag}</span>
            ))}
          </div>

          <!-- Author -->
          <div class="tcard__author">
            <div class="tcard__avatar" aria-hidden="true">{t.initials}</div>
            <div>
              <p class="tcard__name">{t.name}</p>
              <p class="tcard__role">{t.role}</p>
            </div>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>

<style>
  .testi {
    background-color: var(--color-canvas);
  }

  /* ── Header ──────────────────────────────────── */
  .testi__header {
    max-width: 520px;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .testi__title {
    margin: 0;
    color: var(--color-charcoal);
  }

  .testi__title em {
    font-style: italic;
    color: var(--color-coconut);
  }

  /* ── Lab Banner ──────────────────────────────── */
  .testi__lab {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1.5rem;
    align-items: center;
    padding: 2rem;
    background-color: var(--color-surface);
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-mist);
    margin-bottom: 2.5rem;
    box-shadow: var(--shadow-card);
  }

  .testi__lab-icon-wrap {
    width: 56px;
    height: 56px;
    background-color: color-mix(in srgb, var(--color-sage) 10%, transparent);
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-sage);
    flex-shrink: 0;
  }

  .testi__lab-body { flex: 1; }

  .testi__lab-title {
    font-family: var(--font-serif);
    font-size: var(--text-h4);
    color: var(--color-charcoal);
    margin: 0 0 0.5rem;
  }

  .testi__lab-desc {
    font-size: var(--text-body-sm);
    color: var(--color-charcoal-soft);
    line-height: 1.7;
    margin: 0;
  }

  .testi__lab-stat {
    text-align: right;
    flex-shrink: 0;
    padding-left: 1.5rem;
    border-left: 1px solid var(--color-mist);
  }

  .testi__lab-num {
    display: block;
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 700;
    color: var(--color-sage);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .testi__lab-label {
    display: block;
    font-size: var(--text-caption);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-charcoal-soft);
    max-width: 120px;
    margin-top: 0.375rem;
    line-height: 1.4;
  }

  /* ── Grid ────────────────────────────────────── */
  .testi__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  /* ── Card ────────────────────────────────────── */
  .tcard {
    background-color: var(--color-surface);
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-mist);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    box-shadow: var(--shadow-card);
    transition:
      box-shadow var(--duration-base) var(--ease-smooth),
      transform var(--duration-base) var(--ease-smooth),
      border-color var(--duration-base) var(--ease-smooth);
  }

  .tcard:hover {
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-4px);
    border-color: rgba(164,130,97,0.25);
  }

  /* Stars */
  .tcard__stars {
    display: flex;
    gap: 2px;
    color: var(--color-coconut);
  }

  /* Quote */
  .tcard__quote {
    margin: 0;
    flex: 1;
  }

  .tcard__quote p {
    font-family: var(--font-serif);
    font-size: 0.9375rem;
    font-style: italic;
    color: var(--color-charcoal);
    line-height: 1.75;
    margin: 0;
    padding-left: 1rem;
    border-left: 2px solid var(--color-coconut-light);
  }

  /* Tags */
  .tcard__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  /* Author */
  .tcard__author {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding-top: 0.875rem;
    border-top: 1px solid var(--color-mist);
    margin-top: auto;
  }

  .tcard__avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: color-mix(in srgb, var(--color-coconut) 12%, var(--color-canvas));
    border: 1px solid var(--color-mist-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--color-coconut-dark);
    flex-shrink: 0;
  }

  .tcard__name {
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    font-weight: 600;
    color: var(--color-charcoal);
    margin: 0;
  }

  .tcard__role {
    font-size: var(--text-caption);
    color: var(--color-charcoal-soft);
    margin: 0.125rem 0 0;
  }

  /* ── Responsive ─────────────────────────────── */
  @media (max-width: 1024px) {
    .testi__lab {
      grid-template-columns: auto 1fr;
      grid-template-rows: auto auto;
    }

    .testi__lab-stat {
      grid-column: 1 / -1;
      border-left: none;
      padding-left: 0;
      border-top: 1px solid var(--color-mist);
      padding-top: 1rem;
      text-align: left;
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .testi__lab-label { max-width: none; }
  }

  @media (max-width: 768px) {
    .testi__grid { grid-template-columns: 1fr; }
  }
</style>
