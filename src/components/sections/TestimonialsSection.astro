---
/**
 * TestimonialsSection — COCOSORB
 * Social proof: ulasan pengguna + ringkasan hasil uji lab.
 */

const testimonials = [
  {
    id: 'testi-1',
    name: 'Rahma D.',
    role: 'Ibu Rumah Tangga, Jakarta Selatan',
    avatar: '👩',
    rating: 5,
    text: 'Lemari pakaian saya dulu selalu bau lembab. Setelah pasang COCOSORB Pouch, dalam 3 hari baunya hilang. Yang bikin senang, tidak ada wangi tiruan — beneran bersih!',
    tags: ['Lemari', 'Pouch'],
  },
  {
    id: 'testi-2',
    name: 'Bima P.',
    role: 'Mahasiswa Arsitektur, Bandung',
    avatar: '👨‍💻',
    rating: 5,
    text: 'Kamar kost saya sempit dan sering bau. Artisan Holder-nya juga jadi hiasan meja. Dua fungsi sekaligus — dekorasi yang benar-benar berguna.',
    tags: ['Artisan Holder', 'Kamar'],
  },
  {
    id: 'testi-3',
    name: 'Sari K.',
    role: 'Pemilik Butik, Yogyakarta',
    avatar: '👩‍💼',
    rating: 5,
    text: 'Saya order Gift Set untuk hampers karyawan. Tampilannya premium banget, dan ceritanya tentang upcycling bikin penerimanya terkesan. Bakal repeat order!',
    tags: ['Gift Set', 'Korporat'],
  },
  {
    id: 'testi-4',
    name: 'Andi R.',
    role: 'Penggemar Otomotif, Surabaya',
    avatar: '🧑',
    rating: 5,
    text: 'Saya taruh Pouch di kabin mobil. Bau rokok bekas dari pemilik sebelumnya akhirnya hilang dalam 2 minggu. Jauh lebih baik dari parfum gantung biasa.',
    tags: ['Pouch', 'Kabin Mobil'],
  },
];
---

<section id="testimonials" class="section testimonials">
  <div class="container">

    <!-- Header -->
    <div class="testi__header reveal">
      <div class="eyebrow">Ulasan &amp; Validasi</div>
      <h2 class="text-h2 testi__title">
        Dipercaya Pengguna<br />
        <em>dari Rumah ke Rumah.</em>
      </h2>
    </div>

    <!-- Lab Result Banner -->
    <div class="testi__lab reveal delay-100">
      <div class="testi__lab-icon" aria-hidden="true">🔬</div>
      <div class="testi__lab-content">
        <h3 class="testi__lab-title">Divalidasi Uji Laboratorium Independen</h3>
        <p class="testi__lab-desc">
          COCOSORB telah melalui uji penyerapan bau terhadap senyawa amonia (NH₃)
          dan hidrogen sulfida (H₂S). Hasil menunjukkan pengurangan konsentrasi
          hingga <strong>87%</strong> dalam kondisi ruang tertutup selama 24 jam.
        </p>
      </div>
      <div class="testi__lab-stat">
        <span class="testi__lab-num">87%</span>
        <span class="testi__lab-label">Pengurangan Bau (Uji Lab)</span>
      </div>
    </div>

    <!-- Testimonial Cards Grid -->
    <div class="testi__grid">
      {testimonials.map((t, index) => (
        <article
          class={`testi__card reveal delay-${(index + 1) * 100}`}
          id={t.id}
          aria-label={`Ulasan dari ${t.name}`}
        >
          <!-- Stars -->
          <div class="testi__stars" aria-label={`${t.rating} dari 5 bintang`}>
            {Array.from({ length: t.rating }).map(() => (
              <span aria-hidden="true">★</span>
            ))}
          </div>

          <!-- Quote -->
          <blockquote class="testi__quote">
            "{t.text}"
          </blockquote>

          <!-- Tags -->
          <div class="testi__tags">
            {t.tags.map(tag => (
              <span class="badge badge-natural">{tag}</span>
            ))}
          </div>

          <!-- Author -->
          <div class="testi__author">
            <div class="testi__avatar" aria-hidden="true">{t.avatar}</div>
            <div>
              <p class="testi__name">{t.name}</p>
              <p class="testi__role">{t.role}</p>
            </div>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>

<style>
  .testimonials {
    background-color: var(--color-canvas);
  }

  /* ── Header ──────────────────────────────────── */
  .testi__header {
    max-width: 560px;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .testi__title {
    margin: 0;
    color: var(--color-charcoal);
  }

  .testi__title em {
    font-style: italic;
    color: var(--color-coconut);
  }

  /* ── Lab Banner ──────────────────────────────── */
  .testi__lab {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.75rem 2rem;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--color-sage) 10%, var(--color-surface)),
      color-mix(in srgb, var(--color-coconut) 6%, var(--color-surface))
    );
    border-radius: var(--radius-xl);
    border: 1px solid color-mix(in srgb, var(--color-sage) 25%, transparent);
    margin-bottom: 2.5rem;
  }

  .testi__lab-icon {
    font-size: 2.5rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .testi__lab-content {
    flex: 1;
  }

  .testi__lab-title {
    font-family: var(--font-serif);
    font-size: var(--text-h4);
    color: var(--color-charcoal);
    margin: 0 0 0.5rem;
  }

  .testi__lab-desc {
    font-size: var(--text-body-sm);
    color: var(--color-charcoal-soft);
    line-height: 1.7;
    margin: 0;
  }

  .testi__lab-stat {
    text-align: center;
    flex-shrink: 0;
  }

  .testi__lab-num {
    display: block;
    font-family: var(--font-serif);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    color: var(--color-sage);
    line-height: 1;
  }

  .testi__lab-label {
    display: block;
    font-size: var(--text-caption);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-charcoal-soft);
    max-width: 120px;
    margin-top: 0.25rem;
    text-align: center;
  }

  /* ── Testimonial Grid ────────────────────────── */
  .testi__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  /* ── Testimonial Card ────────────────────────── */
  .testi__card {
    background-color: var(--color-surface);
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-mist);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    box-shadow: var(--shadow-card);
    transition:
      box-shadow var(--duration-base) var(--ease-smooth),
      transform var(--duration-base) var(--ease-smooth);
  }

  .testi__card:hover {
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-4px);
  }

  /* Stars */
  .testi__stars {
    display: flex;
    gap: 0.125rem;
    color: var(--color-coconut);
    font-size: 1rem;
  }

  /* Quote */
  .testi__quote {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-style: italic;
    color: var(--color-charcoal);
    line-height: 1.7;
    margin: 0;
    flex: 1;
    position: relative;
    padding-left: 1.25rem;
  }

  .testi__quote::before {
    content: '"';
    position: absolute;
    left: 0;
    top: -0.25rem;
    font-size: 2rem;
    color: var(--color-coconut-light);
    font-style: normal;
    line-height: 1;
  }

  /* Tags */
  .testi__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  /* Author */
  .testi__author {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-mist);
  }

  .testi__avatar {
    font-size: 2rem;
    line-height: 1;
    width: 44px;
    height: 44px;
    background-color: var(--color-mist);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .testi__name {
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    font-weight: 600;
    color: var(--color-charcoal);
    margin: 0;
  }

  .testi__role {
    font-size: var(--text-caption);
    color: var(--color-charcoal-soft);
    margin: 0.125rem 0 0;
  }

  /* ── Responsive ─────────────────────────────── */
  @media (max-width: 1024px) {
    .testi__lab {
      flex-wrap: wrap;
    }

    .testi__lab-stat {
      width: 100%;
      text-align: left;
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .testi__lab-num {
      font-size: 2rem;
    }

    .testi__lab-label {
      max-width: none;
      text-align: left;
    }
  }

  @media (max-width: 768px) {
    .testi__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
