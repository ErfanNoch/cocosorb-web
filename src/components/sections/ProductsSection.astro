---
/**
 * ProductsSection - COCOSORB
 * Product cards dengan placeholder gambar yang proper (no emoji).
 * Data driven dari site.config.ts.
 */
import { PRODUCTS, CONTACT } from '../../config/site';
---

<section id="products" class="section products">
  <div class="container">

    <!-- Header -->
    <div class="products__header reveal">
      <div class="eyebrow">Katalog Produk</div>
      <h2 class="text-h2 products__title">
        Temukan Solusi<br />
        <em>yang Tepat untuk Ruangan Anda.</em>
      </h2>
      <p class="text-body-lg text-charcoal-soft products__intro">
        Setiap varian COCOSORB dirancang untuk konteks dan kebutuhan yang berbeda -
        semuanya berbasis arang aktif tempurung kelapa lokal.
      </p>
    </div>

    <!-- Grid -->
    <div class="products__grid">
      {PRODUCTS.map((product, index) => (
        <article
          class={`pcard reveal delay-${(index % 2 + 1) * 100}`}
          id={`product-${product.id}`}
          aria-label={product.fullName}
        >
          <!-- Image area -->
          <div class="pcard__img-wrap">
            <div
              class="pcard__img-placeholder"
              style={`background: ${product.imagePlaceholder};`}
              role="img"
              aria-label={`Foto ${product.fullName} - segera hadir`}
            >
              <!-- Subtle grid texture -->
              <div class="pcard__img-grid" aria-hidden="true"></div>
              <!-- Product name watermark -->
              <div class="pcard__img-watermark" aria-hidden="true">
                <span class="pcard__img-wm-brand">COCOSORB</span>
                <span class="pcard__img-wm-name">{product.name}</span>
              </div>
            </div>

            <!-- Badge -->
            {product.badge && (
              <span class={`badge badge-${product.badgeType} pcard__badge`}>
                {product.badge}
              </span>
            )}
          </div>

          <!-- Body -->
          <div class="pcard__body">

            <!-- Tags -->
            <div class="pcard__tags">
              {product.tags.map(tag => (
                <span class="pcard__tag">{tag}</span>
              ))}
            </div>

            <h3 class="pcard__name">{product.fullName}</h3>
            <p class="pcard__tagline">{product.tagline}</p>
            <p class="pcard__desc">{product.description}</p>

            <!-- Features -->
            <ul class="pcard__features" aria-label="Fitur utama">
              {product.features.map(f => (
                <li class="pcard__feature">
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" class="pcard__check">
                    <circle cx="7" cy="7" r="6" stroke="currentColor" stroke-width="1.2"/>
                    <path d="M4.5 7l2 2L9.5 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  {f}
                </li>
              ))}
            </ul>

            <!-- Purchase CTAs -->
            <div class="pcard__actions">
              <a
                href={`https://wa.me/${CONTACT.whatsapp.number}?text=${encodeURIComponent(product.whatsappMessage)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-primary pcard__btn"
                id={`product-wa-${product.id}`}
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z M12 0C5.373 0 0 5.373 0 12c0 2.083.535 4.04 1.472 5.745L0 24l6.405-1.438A11.93 11.93 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.89 0-3.658-.518-5.175-1.415l-.371-.22-3.802.854.855-3.717-.242-.383A9.937 9.937 0 0 1 2 12c0-5.514 4.486-10 10-10s10 4.486 10 10-4.486 10-10 10z"/>
                </svg>
                Pesan via WhatsApp
              </a>

              {product.shopeeUrl && (
                <div class="pcard__marketplace">
                  <a
                    href={product.shopeeUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="pcard__market-link"
                    id={`product-shopee-${product.id}`}
                    aria-label={`Beli ${product.fullName} di Shopee`}
                  >
                    Shopee
                  </a>
                  <span class="pcard__market-sep" aria-hidden="true">·</span>
                  <a
                    href={product.tokopediaUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="pcard__market-link"
                    id={`product-tokopedia-${product.id}`}
                    aria-label={`Beli ${product.fullName} di Tokopedia`}
                  >
                    Tokopedia
                  </a>
                </div>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Bottom -->
    <div class="products__bottom reveal">
      <p class="text-charcoal-soft">Butuh rekomendasi atau pembelian dalam jumlah besar?</p>
      <a
        href={`https://wa.me/${CONTACT.whatsapp.number}?text=${encodeURIComponent('Halo COCOSORB, saya ingin konsultasi produk untuk kebutuhan spesifik.')}`}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-outline"
        id="products-consult-cta"
      >
        Konsultasi Produk
      </a>
    </div>

  </div>
</section>

<style>
  .products {
    background-color: var(--color-canvas);
  }

  /* ── Header ──────────────────────────────────── */
  .products__header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 3.5rem;
    max-width: 640px;
  }

  .products__title {
    margin: 0;
    color: var(--color-charcoal);
  }

  .products__title em {
    font-style: italic;
    color: var(--color-coconut);
  }

  .products__intro { margin: 0; }

  /* ── Product Grid ────────────────────────────── */
  .products__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.75rem;
    margin-bottom: 3rem;
  }

  /* ── Product Card ────────────────────────────── */
  .pcard {
    background-color: var(--color-surface);
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-mist);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition:
      box-shadow var(--duration-base) var(--ease-smooth),
      transform var(--duration-base) var(--ease-smooth),
      border-color var(--duration-base) var(--ease-smooth);
  }

  .pcard:hover {
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-6px);
    border-color: rgba(164,130,97,0.3);
  }

  /* Image wrapper */
  .pcard__img-wrap {
    position: relative;
    overflow: hidden;
  }

  .pcard__img-placeholder {
    position: relative;
    width: 100%;
    aspect-ratio: 4/3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    overflow: hidden;
    transition: transform var(--duration-slow) var(--ease-smooth);
  }

  .pcard:hover .pcard__img-placeholder {
    transform: scale(1.02);
  }

  /* Fine grid on placeholder */
  .pcard__img-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.12) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.12) 1px, transparent 1px);
    background-size: 32px 32px;
  }

  /* Text watermark */
  .pcard__img-watermark {
    position: relative;
    z-index: 1;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .pcard__img-wm-brand {
    font-family: var(--font-sans);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.5);
  }

  .pcard__img-wm-name {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    font-weight: 600;
    color: rgba(255,255,255,0.7);
    letter-spacing: 0.02em;
  }

  /* Badge */
  .pcard__badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
  }

  /* Body */
  .pcard__body {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1;
  }

  /* Tags */
  .pcard__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .pcard__tag {
    font-size: var(--text-caption);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-charcoal-soft);
    background-color: var(--color-mist);
    border-radius: var(--radius-sm);
    padding: 0.2rem 0.6rem;
  }

  /* Name */
  .pcard__name {
    font-family: var(--font-serif);
    font-size: var(--text-h4);
    color: var(--color-charcoal);
    margin: 0;
    line-height: 1.3;
  }

  .pcard__tagline {
    font-size: var(--text-body-sm);
    font-weight: 500;
    color: var(--color-coconut);
    letter-spacing: 0.04em;
    margin: 0;
  }

  .pcard__desc {
    font-size: var(--text-body-sm);
    color: var(--color-charcoal-soft);
    line-height: 1.75;
    margin: 0;
  }

  /* Features */
  .pcard__features {
    list-style: none;
    margin: 0.25rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  .pcard__feature {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-body-sm);
    color: var(--color-charcoal-soft);
  }

  .pcard__check {
    color: var(--color-sage);
    flex-shrink: 0;
  }

  /* Actions */
  .pcard__actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-mist);
  }

  .pcard__btn {
    justify-content: center;
  }

  .pcard__marketplace {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .pcard__market-link {
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-charcoal-soft);
    text-decoration: none;
    transition: color var(--duration-base) var(--ease-smooth);
  }

  .pcard__market-link:hover {
    color: var(--color-coconut);
  }

  .pcard__market-sep {
    color: var(--color-mist-dark);
    font-size: 1rem;
  }

  /* ── Bottom ──────────────────────────────────── */
  .products__bottom {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .products__bottom p {
    margin: 0;
  }

  /* ── Responsive ─────────────────────────────── */
  @media (max-width: 768px) {
    .products__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
