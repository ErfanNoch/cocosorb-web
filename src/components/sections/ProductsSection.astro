---
/**
 * ProductsSection — COCOSORB
 * Katalog 4 varian produk utama.
 * Data produk disimpan di dalam frontmatter agar mudah di-extend
 * ke content collections nantinya.
 */

const products = [
  {
    id: 'dupa',
    name: 'Room Odor Absorber Dupa',
    tagline: 'Elegan. Tradisional. Efektif.',
    description:
      'Arang aktif tempurung kelapa dalam wadah dupa estetik. Adsorpsi aktif menarik molekul bau secara pasif — tanpa asap, tanpa parfum.',
    icon: '🕯️',
    features: ['Luas area 15–20 m²', 'Efektif 30+ hari', 'Isi ulang tersedia'],
    tags: ['Ruang Tamu', 'Kamar Tidur'],
    badge: 'Terlaris',
    badgeType: 'coconut',
    href: '#product-dupa',
  },
  {
    id: 'pouch',
    name: 'Room Odor Absorber Pouch',
    tagline: 'Praktis. Fleksibel. Tersembunyi.',
    description:
      'Kantong arang aktif dalam kain perca lokal. Pas untuk lemari pakaian, laci, atau sepatu — dimana pun bau bersembunyi.',
    icon: '👝',
    features: ['Fleksibel multi-ruang', 'Bisa diperbarui sinar matahari', 'Isi ulang tersedia'],
    tags: ['Lemari', 'Sepatu', 'Kabin Mobil'],
    badge: 'Serbaguna',
    badgeType: 'sage',
    href: '#product-pouch',
  },
  {
    id: 'artisan',
    name: 'Artisan Holder',
    tagline: 'Kerajinan. Karakter. Berkelanjutan.',
    description:
      'Wadah arang aktif handmade dari perajin lokal. Setiap piece unik — perpaduan fungsi udara bersih dan estetika kriya nusantara.',
    icon: '🏺',
    features: ['Handmade UMKM lokal', 'Dekorasi + fungsi', 'Isi ulang tersedia'],
    tags: ['Dekorasi', 'Hadiah'],
    badge: 'Edisi Kriya',
    badgeType: 'coconut',
    href: '#product-artisan',
  },
  {
    id: 'gift-set',
    name: 'Gift Set',
    tagline: 'Hadiah Bermakna. Dampak Nyata.',
    description:
      'Paket kompilasi terkurasi — Artisan Holder + Pouch dalam kotak hadiah premium daur ulang. Pilihan suvenir yang bercerita.',
    icon: '🎁',
    features: ['Kemasan hadiah premium', 'Kombinasi 2–3 produk', 'Kartu pesan personal'],
    tags: ['Suvenir', 'Hadiah', 'Korporat'],
    badge: 'Edisi Spesial',
    badgeType: 'sage',
    href: '#product-gift-set',
  },
];
---

<section id="products" class="section products">
  <div class="container">

    <!-- Header -->
    <div class="products__header reveal">
      <div class="eyebrow">Katalog Produk</div>
      <h2 class="text-h2 products__title">
        Temukan Solusi<br />
        <em>yang Tepat untuk Ruangan Anda.</em>
      </h2>
      <p class="text-body-lg text-charcoal-soft" style="max-width: 52ch;">
        Setiap varian COCOSORB dirancang untuk konteks dan kebutuhan yang berbeda —
        semuanya berbasis arang aktif tempurung kelapa.
      </p>
    </div>

    <!-- Product Grid -->
    <div class="products__grid">
      {products.map((product, index) => (
        <article
          class={`product-card reveal delay-${(index + 1) * 100}`}
          id={`product-${product.id}`}
          aria-label={`Produk: ${product.name}`}
        >
          <!-- Visual -->
          <div class="product-card__visual">
            <div class="product-card__icon" aria-hidden="true">{product.icon}</div>
            {product.badge && (
              <span class={`badge badge-${product.badgeType} product-card__badge`}>
                {product.badge}
              </span>
            )}
          </div>

          <!-- Content -->
          <div class="product-card__body">
            <!-- Tags -->
            <div class="product-card__tags">
              {product.tags.map(tag => (
                <span class="product-card__tag">{tag}</span>
              ))}
            </div>

            <h3 class="product-card__name">COCOSORB {product.name}</h3>
            <p class="product-card__tagline">{product.tagline}</p>
            <p class="product-card__desc">{product.description}</p>

            <!-- Features -->
            <ul class="product-card__features" aria-label="Fitur utama">
              {product.features.map(f => (
                <li class="product-card__feature">
                  <svg class="product-card__check" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <circle cx="7" cy="7" r="6.5" stroke="currentColor"/>
                    <path d="M4.5 7l2 2L9.5 5.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  {f}
                </li>
              ))}
            </ul>

            <!-- CTA -->
            <a href={product.href} class="btn btn-outline product-card__cta" id={`product-cta-${product.id}`}>
              Lihat Detail
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M2.5 7h9M8 3.5L11.5 7 8 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- Bottom CTA -->
    <div class="products__bottom reveal">
      <p class="text-charcoal-soft">Butuh rekomendasi produk untuk kebutuhan spesifik?</p>
      <a
        href="https://wa.me/62XXXXXXXXXX?text=Halo%20COCOSORB%2C%20saya%20ingin%20konsultasi%20produk"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary"
        id="products-wa-cta"
      >
        💬 Konsultasi via WhatsApp
      </a>
    </div>

  </div>
</section>

<style>
  .products {
    background-color: var(--color-canvas);
  }

  /* ── Header ──────────────────────────────────── */
  .products__header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 3.5rem;
  }

  .products__title {
    margin: 0;
    color: var(--color-charcoal);
  }

  .products__title em {
    font-style: italic;
    color: var(--color-coconut);
  }

  /* ── Product Grid ────────────────────────────── */
  .products__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  /* ── Product Card ────────────────────────────── */
  .product-card {
    background-color: var(--color-surface);
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-mist);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-card);
    transition:
      box-shadow var(--duration-base) var(--ease-smooth),
      transform var(--duration-base) var(--ease-smooth),
      border-color var(--duration-base) var(--ease-smooth);
  }

  .product-card:hover {
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-6px);
    border-color: var(--color-coconut-light);
  }

  /* Visual area */
  .product-card__visual {
    position: relative;
    background: linear-gradient(
      145deg,
      color-mix(in srgb, var(--color-coconut) 8%, var(--color-canvas)),
      color-mix(in srgb, var(--color-sage) 5%, var(--color-surface))
    );
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .product-card__icon {
    font-size: 4rem;
    line-height: 1;
    filter: drop-shadow(0 4px 12px rgba(164,130,97,0.2));
    transition: transform var(--duration-base) var(--ease-bounce);
  }

  .product-card:hover .product-card__icon {
    transform: scale(1.1);
  }

  .product-card__badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
  }

  /* Body area */
  .product-card__body {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1;
  }

  .product-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .product-card__tag {
    font-size: var(--text-caption);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-charcoal-soft);
    background-color: var(--color-mist);
    border-radius: var(--radius-sm);
    padding: 0.2rem 0.5rem;
  }

  .product-card__name {
    font-family: var(--font-serif);
    font-size: var(--text-h4);
    color: var(--color-charcoal);
    margin: 0;
    line-height: 1.3;
  }

  .product-card__tagline {
    font-size: var(--text-body-sm);
    font-weight: 500;
    color: var(--color-coconut);
    letter-spacing: 0.02em;
    margin: 0;
  }

  .product-card__desc {
    font-size: var(--text-body-sm);
    color: var(--color-charcoal-soft);
    line-height: 1.7;
    margin: 0;
  }

  /* Features list */
  .product-card__features {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    flex: 1;
  }

  .product-card__feature {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-body-sm);
    color: var(--color-charcoal-soft);
  }

  .product-card__check {
    color: var(--color-sage);
    flex-shrink: 0;
  }

  /* CTA */
  .product-card__cta {
    margin-top: 0.5rem;
    align-self: flex-start;
  }

  /* ── Bottom CTA ──────────────────────────────── */
  .products__bottom {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  /* ── Responsive ─────────────────────────────── */
  @media (max-width: 768px) {
    .products__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
